{
  "name": "agent-skills-sync",
  "version": "0.1.0",
  "description": "Safely expose selected Agent Skills from .agents/skills to Claude Code via managed symlinks.",
  "type": "module",
  "bin": {
    "agent-skills-sync": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vectorstone/skills-sync.git"
  },
  "bugs": {
    "url": "https://github.com/vectorstone/skills-sync/issues"
  },
  "homepage": "https://github.com/vectorstone/skills-sync#readme",
  "keywords": [
    "agent-skills",
    "claude-code",
    "skills",
    "symlink",
    "developer-tools",
    "cli"
  ],
  "author": "vectorstone",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.8.0",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^24.0.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.31.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0",
    "vitest": "^3.2.4"
  }
}
